# The worker image (RFC 0018 §5.4, §6.3): the same `batlehub` binary as the
# proxy image, started with `--roles worker`, plus the scanner toolchains the
# proxy image deliberately does not carry — bubblewrap for the sandbox,
# postmortem, the Trivy client and yara-x's `yr` (RFC 0036 §6.6).
#
# Why a second image rather than a fatter proxy image: only the worker opens
# artifacts, so only the worker needs the tools that open them, and the proxy
# keeps its distroless, shell-less runtime. The two roles share nothing but the
# database and the storage backend; NetworkPolicies tighten around that.
#
# GuardDog is *not* here. It is the one scanner with an interpreter behind it,
# and it is optional (RFC 0018 §13) — so it lives in a third image that adds it
# to this one, `Containerfile.worker-guarddog`, and a deployment that enables
# `[scanners.guarddog]` runs that image instead of this one. Everything this
# image carries is a static binary.
#
# Every tool is pinned. `mise.toml` pins the same postmortem and trivy for the
# developer machine and CI, so the three run the identical scanner.
#
#   podman build -f Containerfile.worker -t batlehub-worker .
#   podman run --rm -v ./config.toml:/etc/batlehub/config.toml:ro batlehub-worker

ARG POSTMORTEM_VERSION=2.4.0
ARG TRIVY_VERSION=0.76.1
ARG YARA_X_VERSION=1.20.0
# The release's own asset digest (GitHub's `digest` field); the binary runs
# operator rules over hostile bytes, so it is checked, not only fetched.
ARG YARA_X_SHA256=cabb8df46492fff59c51261302c71ed9cb2cef393d3f0ca560801a34a8e24cbe

# ── Build stage: the server binary, as the proxy image builds it ─────────────
# cargo-chef for the same reason as in `Containerfile`: the recipe survives the
# version bump, so the dependency layer is not cold on every release.
FROM rust:1.98-slim-bookworm@sha256:ebd900bae66fd508b466cef82d64a83a5fb34682e4c8b2797a42908bddc95a57 AS chef

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl libssl-dev make pkg-config \
    && rm -rf /var/lib/apt/lists/*
RUN cargo install --locked cargo-chef --version 0.1.78
WORKDIR /build

FROM chef AS planner
COPY Cargo.toml Cargo.lock ./
COPY crates/  crates/
COPY server/  server/
COPY cli/     cli/
COPY patches/ patches/
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
COPY patches/ patches/
COPY --from=planner /build/recipe.json recipe.json
RUN cargo chef cook --locked --release --recipe-path recipe.json -p batlehub-server
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY server/ server/
COPY cli/ cli/
RUN cargo build --locked --release -p batlehub-server

# The release overrides this stage with `--build-context server=<dir>` holding
# the binary the proxy image's amd64 leg already built, so the release compiles
# the server once (TD-0003 §3). A local build or `image-scan.yaml` has no such
# directory and builds it above.
FROM scratch AS server
COPY --from=builder /build/target/release/batlehub /batlehub

# ── Scanner toolchains ───────────────────────────────────────────────────────
FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS tools
ARG POSTMORTEM_VERSION
ARG TRIVY_VERSION
ARG YARA_X_VERSION
ARG YARA_X_SHA256
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl gzip tar \
    && rm -rf /var/lib/apt/lists/*
# postmortem: the release binary (the asset names are the ones the project
# publishes: `postmortem-<version>-x86_64-unknown-linux-gnu.tar.gz`).
# `--proto '=https' --proto-redir '=https'`: the release host answers with a
# redirect to its object store, and neither hop may be talked out of TLS.
RUN releases="https://github.com/mlab-sh/postmortem/releases/download" \
    && mkdir -p /tmp/pm \
    && curl -fsSL --proto '=https' --proto-redir '=https' \
        "$releases/v${POSTMORTEM_VERSION}/postmortem-${POSTMORTEM_VERSION}-x86_64-unknown-linux-gnu.tar.gz" \
    | tar -xz -C /tmp/pm \
    && install -m 0755 "$(find /tmp/pm -type f -name postmortem | head -1)" /usr/local/bin/postmortem \
    && rm -rf /tmp/pm
# Trivy: the client; the database lives on the Trivy server the chart deploys
# (`[scanners.trivy] endpoint`), or is downloaded on first use.
RUN releases="https://github.com/aquasecurity/trivy/releases/download" \
    && mkdir -p /tmp/tv \
    && curl -fsSL --proto '=https' --proto-redir '=https' \
        "$releases/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz" \
    | tar -xz -C /tmp/tv \
    && install -m 0755 "$(find /tmp/tv -type f -name trivy | head -1)" /usr/local/bin/trivy \
    && rm -rf /tmp/tv
# yara-x's CLI, for `[scanners.yara]`: a static binary, idle unless a rules
# directory is configured.
RUN releases="https://github.com/VirusTotal/yara-x/releases/download" \
    && asset="yara-x-v${YARA_X_VERSION}-x86_64-unknown-linux-gnu.tar.gz" \
    && mkdir -p /tmp/yx \
    && curl -fsSL --proto '=https' --proto-redir '=https' -o "/tmp/yx/$asset" \
        "$releases/v${YARA_X_VERSION}/$asset" \
    && echo "${YARA_X_SHA256}  /tmp/yx/$asset" | sha256sum -c - \
    && tar -xzf "/tmp/yx/$asset" -C /tmp/yx \
    && install -m 0755 /tmp/yx/yr /usr/local/bin/yr \
    && rm -rf /tmp/yx

# ── Runtime image ─────────────────────────────────────────────────────────────
# Debian rather than distroless: `bwrap` needs a userland, and the GuardDog
# image builds on this one. Still no shell on the entrypoint path — the runner
# passes argv directly — and the process runs as the same non-root uid as the
# proxy.
FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS runtime
# `upgrade` before `install`, and it is not belt-and-braces: the base is pinned
# by digest, and Debian publishes security fixes into `bookworm-security` for
# weeks before a rebuilt `bookworm-slim` carries them. Without this the daily
# rebuild-and-rescan in `image-scan.yaml` rebuilds the *same* userland every
# day and the gate blocks on a CVE the archive has already fixed — which is
# exactly what happened with libpcre2 (CVE-2026-86145, CVE-2026-89161: fixed in
# 10.42-1+deb12u1 while the current `bookworm-slim` still ships 10.42-1, and
# there is no newer digest to move the pin to).
RUN apt-get update && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends \
    bubblewrap ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 65532 nonroot && useradd -u 65532 -g 65532 -M -s /usr/sbin/nologin nonroot \
    && mkdir -p /var/cache/batlehub /tmp/batlehub && chown 65532:65532 /var/cache/batlehub /tmp/batlehub

COPY --from=server /batlehub /usr/local/bin/batlehub
COPY --from=tools /usr/local/bin/postmortem /usr/local/bin/postmortem
COPY --from=tools /usr/local/bin/trivy      /usr/local/bin/trivy
COPY --from=tools /usr/local/bin/yr         /usr/local/bin/yr

# The sandbox's per-job work directories go under TMPDIR; the chart mounts an
# emptyDir here (`noexec` where the node allows it).
ENV TMPDIR=/tmp/batlehub

# The worker exposes /livez and /metrics only.
EXPOSE 8080

USER 65532:65532

ENTRYPOINT ["batlehub"]
CMD ["--config", "/etc/batlehub/config.toml", "--roles", "worker"]
