# Backend base URL. You usually do NOT set this here: `task ui:dev` (5173,
# public FQDN) and `task ui:dev:local` (5174, in-pod) each load a `--mode` env
# file that sets it, and a mode file outranks `.env`. Set it here only when
# running `vite` directly with no mode.
# VITE_API_BASE_URL=http://localhost:8080

# Documentation site URL (a trailing slash is added when missing).
VITE_DOCS_URL=https://batlehub.dev/
