{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue"
  ],
  "exclude": [
    "src/config/registryTypes.docs.test.ts",
    "src/config/adminSections.files.test.ts",
    "src/design/composed-contrast.test.ts",
    "src/design/system-rules.test.ts",
    "src/design/tokens.test.ts",
    "src/test/fixtures.test.ts",
    "src/test/link-targets.test.ts",
    "src/test/stub-server.test.ts"
  ]
}
