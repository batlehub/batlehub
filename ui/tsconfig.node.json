{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "vite.config.ts",
    "openapi-ts.config.ts",
    "build/**/*.ts",
    "src/design/tokens.test.ts",
    "src/test/fixtures.test.ts",
    "src/test/stub-server.test.ts",
    "src/config/registryTypes.docs.test.ts",
    "src/config/adminSections.files.test.ts",
    "src/design/composed-contrast.test.ts",
    "src/design/system-rules.test.ts"
  ]
}
