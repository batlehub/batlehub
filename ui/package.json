{
  "name": "batlehub-ui",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "scripts": {
    "dev": "vite --mode localhost --port 5174 --strictPort",
    "dev:local": "vite --mode localhost --port 5174 --strictPort",
    "dev:fqdn": "vite --port 5173 --strictPort",
    "build": "vue-tsc -b && vite build && node build/copy-scalar.mjs",
    "preview": "vite preview",
    "generate": "openapi-ts",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "lint:eslint": "eslint src --ext .ts,.vue",
    "lint:eslint:fix": "eslint src --ext .ts,.vue --fix",
    "format": "oxfmt --write src",
    "format:check": "oxfmt --check src",
    "i18n:audit": "node build/i18n-audit.mjs",
    "i18n:check": "node build/i18n-audit.mjs --max 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@lucide/vue": "^1.55.0",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-vue": "^1.9.17",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@scalar/api-reference": "^1.73.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^30.1.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "puppeteer-core": "^25.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
