      "tool": {
        "driver": {
          "informationUri": "https://github.com/mlab-sh/postmortem",
          "name": "postmortem",
          "rules": [
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "The dependency raised one or more supply-chain reputation or identity signals — low stars, a freshly-created or transferred repository, a typosquat of a popular name, a newly-added install script, a dormant release, or a new publisher."
              },
              "help": {
                "markdown": "See the [postmortem README](https://github.com/mlab-sh/postmortem#--online-reputation--the-riskdep-scores) for how `tree --online` scores reputation.",
                "text": "See https://github.com/mlab-sh/postmortem#--online-reputation--the-riskdep-scores for how tree scores reputation."
              },
              "id": "postmortem.dependency-risk",
              "name": "postmortem.dependency-risk",
              "properties": {
                "precision": "medium",
                "tags": [
                  "security",
                  "supply-chain",
                  "reputation"
                ]
              },
              "shortDescription": {
                "text": "Dependency reputation / identity risk"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "A dependency version matches a published advisory (OSV / GHSA / CVE) from the mlab SBOM scan."
              },
              "help": {
                "markdown": "See the [postmortem README](https://github.com/mlab-sh/postmortem#--vulns-known-vulnerabilities) for the vulnerability source.",
                "text": "See https://github.com/mlab-sh/postmortem#--vulns-known-vulnerabilities for the vulnerability source."
              },
              "id": "postmortem.known-vulnerability",
              "name": "postmortem.known-vulnerability",
              "properties": {
                "precision": "high",
                "tags": [
                  "security",
                  "supply-chain",
                  "vulnerability"
                ]
              },
              "shortDescription": {
                "text": "Known vulnerability in dependency"
              }
            }
          ],
          "semanticVersion": "2.9.2",
          "version": "2.9.2"
        }
      }
    }
  ],
  "version": "2.1.0"
